data_AF3_TEMPLATE_A
#
_entry.id AF3_TEMPLATE_A
#
_struct.title 'AF3 builder fixture A: six-residue protein template, fully resolved'
#
# Fixture A. Polymer sequence ACDEFG (Ala-Cys-Asp-Glu-Phe-Gly), one chain A,
# residues 1-6, and a CA atom for every residue: nothing is unresolved, so a
# six-residue query maps one-to-one.
#
_entity_poly.entity_id 1
_entity_poly.type 'polypeptide(L)'
_entity_poly.pdbx_strand_id A
_entity_poly.pdbx_seq_one_letter_code ACDEFG
#
