data_AF3_TEMPLATE_B
#
_entry.id AF3_TEMPLATE_B
#
_struct.title 'AF3 builder fixture B: seven-residue polymer with four resolved residues'
#
# Fixture B. The template's FULL polymer sequence is ACQDEFG (seven residues,
# ACQDEFG = Ala-Cys-Gln-Asp-Glu-Phe-Gly), declared by _entity_poly and by the
# seven rows of _entity_poly_seq. Only the last four residues - ASP 4,
# GLU 5, PHE 6, GLY 7 - carry coordinates: ALA 1, CYS 2 and GLN 3 are
# unresolved, so there are no _atom_site rows for them.
#
# A query of DEFG therefore maps to template indices 3,4,5,6 - positions in
# the FULL polymer sequence, not 0,1,2,3 (which would be the fourth
# coordinate-bearing residue counted from the first resolved one).
#
_entity_poly.entity_id 1
_entity_poly.type 'polypeptide(L)'
_entity_poly.pdbx_strand_id A
_entity_poly.pdbx_seq_one_letter_code ACQDEFG
#
loop_
_entity_poly_seq.entity_id
_entity_poly_seq.num
_entity_poly_seq.mon_id
1 1 ALA
1 2 CYS
1 3 GLN
1 4 ASP
1 5 GLU
1 6 PHE
1 7 GLY
#
loop_
_struct_asym.id
_struct_asym.entity_id
A 1
#
# Residues 1-3 have no coordinates: no atom_site rows exist for them.
#
loop_
_atom_site.group_PDB
_atom_site.id
_atom_site.type_symbol
_atom_site.label_atom_id
_atom_site.label_asym_id
_atom_site.label_comp_id
_atom_site.label_seq_id
_atom_site.auth_asym_id
_atom_site.auth_seq_id
_atom_site.Cartn_x
_atom_site.Cartn_y
_atom_site.Cartn_z
_atom_site.occupancy
_atom_site.B_iso_or_equiv
ATOM 1 C CA A ASP 4 A 4 0.000 0.000 0.000 1.00 20.00
ATOM 2 C CA A GLU 5 A 5 3.800 0.100 0.200 1.00 22.00
ATOM 3 C CA A PHE 6 A 6 7.400 -0.300 0.900 1.00 24.00
ATOM 4 C CA A GLY 7 A 7 10.900 0.400 1.700 1.00 26.00
#
